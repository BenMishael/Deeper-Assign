{
  "name": "deeper-dive-interview-test",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint . --ext .ts",
    "build": "tsc",
    "build:client": "tsc --project tsconfig.client.json",
    "dev:server": "npm run build:client && tsx watch src/server.ts",
    "dev:client": "tsx watch src/static-server.ts",
    "dev": "npm run build:client && concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "start:server": "npm run build:client && tsx src/server.ts",
    "start:client": "tsx src/static-server.ts",
    "start": "npm run build:client && concurrently \"npm run start:server\" \"npm run start:client\""
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.20.0",
    "@typescript-eslint/parser": "^6.20.0",
    "eslint": "^8.56.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "concurrently": "^8.2.2",
    "express": "^4.18.2"
  }
}
